      "type": "string"
    },
    "message": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "code",
    "message",
    "retryable",
    "details"
  ],
  "title": "ErrorEnvelope",
