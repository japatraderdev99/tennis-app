{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "e2e", "scripts", "*.ts"]
}
